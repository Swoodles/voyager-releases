# voyager-ai/.env
# Copy this to .env and fill in values.

# ── LLM Providers (set whichever you use) ────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Active provider: claude | openai | gemini
ACTIVE_LLM_PROVIDER=claude

# ── Data Sources ──────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
SERP_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
APIFY_TOKEN=

# ── Infrastructure ────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgresql://user:pass@host:5432/voyager

# ── Server ────────────────────────────────────────────────────────
VOYAGER_AI_PORT=3747
SOURCE_TIMEOUT_MS=8000
DISABLE_JOBS=false
